{
  "name": "Anime Data Platform",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "streamlit",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "forwardPorts": [8501, 3000],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit",
      "onAutoForward": "openPreview"
    },
    "3000": {
      "label": "Dagster UI",
      "onAutoForward": "notify"
    }
  }
}
